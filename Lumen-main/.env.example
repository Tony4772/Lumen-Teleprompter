# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CULQI KEYS: Required for donations (Cards & Yape in Soles PEN)
# Get them from https://panel.culqi.com → Desarrollo → API Keys
# Use pk_test_/sk_test_ for sandbox, or pk_live_/sk_live_ for production.
# Copy this file to ".env" and paste your real keys (never commit .env).
CULQI_PUBLIC_KEY="pk_test_XXXXXXXX"
CULQI_SECRET_KEY="sk_test_XXXXXXXX"
